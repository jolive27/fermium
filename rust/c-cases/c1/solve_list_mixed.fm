# C1: list unknowns next to an ordinary unknown, a stop condition on an element, absolute tolerances per unknown
k = [1, 2, 3] / (1 s)
solve
    x' = -k * x
    T' = -T / (2 s)
    with x(0 s) = [1, 1, 1] m, T(0 s) = 300 K
    for t from 0 s to 10 s tolerance 1e-10 absolute 1e-14 m, 1e-12 K
    until x[3] = 0.01 m
print times(T)[end] to 5 digits, ln(100) / k[3] to 5 digits
print x(1 s), T(1 s)
print x(1 s)[2] / (exp(-2) * 1 m) to 6 digits
