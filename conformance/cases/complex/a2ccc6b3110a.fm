z = 3 + 4i
print z, |z|, arg(z) in deg, conj(z)
print re(z), im(z), z.re, z.im
print (1 + 2i) * (3 - 1i), 2 / (1 + 1i), (1 + 1i)^2
print exp((1i) pi) ~= -1 + 0i                # Euler's identity
print sqrt(-4 + 0i), ln(1i), cis(pi/3), polar(2, 45deg)

R = 100 ohm
L = 0.5 H
C = 10 uF
omega = 2pi × 50 Hz
Z = R + 1i omega L + 1 / (1i omega C)           # an impedance: a complex number in Ω
print Z, |Z|, arg(Z) in deg
print (230 + 0i) [V] / Z                # the current, in A
