# Earth around the Sun, version 2: draw the orbit
GM = G M_sun
dt = 1 day
x = 1 AU
y = 0 AU
vx = 0 km/s
vy = 29.78 km/s
xs = []
ys = []

for day_number from 1 to 365
    r = sqrt(x^2 + y^2)
    vx += -GM x / r^3 * dt
    vy += -GM y / r^3 * dt
    x += vx dt
    y += vy dt
    push(xs, x)
    push(ys, y)

print "recorded", len(xs), "positions"
plot ys in AU vs xs in AU to "my_orbit.png"
