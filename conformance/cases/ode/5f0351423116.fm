g = 9.81 m/s²
k = 0.02 / (1 m)
θ = 50°
solve r'' = <0 m/s², -g> - k |r'| r'
  with r(0 s) = <0, 0> m, r'(0 s) = 40 m/s * <cos(θ), sin(θ)>
  for t from 0 s to 60 s tolerance 1e-11
  until r.y = 0 m
print times(r)[end] to 15 digits, r.x[end] to 15 digits
solve v' = -g - k v |v|
  with v(0 s) = 30 m/s
  for t from 0 s to 60 s tolerance 1e-11
  until v = 0 m/s
print times(v)[end] to 15 digits