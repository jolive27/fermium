m = m_e
σ = 1 nm
k0 = 2 / (1 nm)
solve (1i) ħ ∂ ψ/∂t = -ħ²/(2·m) · ∂²ψ/∂x²
    with ψ(x, 0 fs) = (2π σ²)^(-1/4) exp(-x² / (4σ²)) exp((1i) k0 x), ψ(-40 nm, t) = 0 nm^(-1/2), ψ(40 nm, t) = 0 nm^(-1/2)
    for x from -40 nm to 40 nm, t from 0 fs to 30 fs
    grid 2000
print "norm:", ∫ |ψ(x, 30 fs)|² dx from -40 nm to 40 nm
print "centre:", ∫ x |ψ(x, 30 fs)|² dx from -40 nm to 40 nm, "  (ħ k0 t / m =", ħ k0 30 [fs] / m in nm, ")"
