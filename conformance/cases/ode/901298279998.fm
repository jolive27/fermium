# the time-dependent Schrödinger equation for a free particle: ψ(t) = exp(-iEt/ħ)
E = 1.0 eV
T = 2 fs
solve (1i)hbar psi' = E psi with psi(0 s) = 1 for t from 0 s to T
print psi(T), exp(-1i E T / hbar)
print |psi(T)| to 6 digits
print psi.re(T), psi.im(T)

# complex integrals and sums: one quadrature per part
print integral exp(1i pi t^2 / 2) dt from 0 to 2          # Fresnel integrals C(2) + i S(2)
print Sigma(cis(2pi k / 3) for k from 1 to 2)       # -1
g(x) = exp(1i k x) where k = 2 /m
print g'(0 m)
