
λ1 = ln(2) / 3.098 min
λ2 = ln(2) / 26.8 min
λ3 = ln(2) / 19.9 min
λ4 = ln(2) / 164.3 μs
solve
    N1' = -λ1 N1
    N2' = λ1 N1 - λ2 N2
    N3' = λ2 N2 - λ3 N3
    N4' = λ3 N3 - λ4 N4
    with N1(0) = 1e6, N2(0) = 0, N3(0) = 0, N4(0) = 0
    for t from 0 min to 720 min using bdf
