
N = 60
x = zeros(N) [m]
y = zeros(N) [m]
M = zeros(N) [kg]
for k from 1 to N
    x[k] = cos(0.7 k) * k * 1 m
    y[k] = sin(1.3 k) * 1 m
    M[k] = (1 + mod(k, 3)) * 1 kg
ax = zeros(N) [m/s²]
U = 0 J
parallel for i from 1 to N
    fx = 0 m/s²
    for j from 1 to N
        if j != i
            dx = x[j] - x[i]
            dy = y[j] - y[i]
            r = √(dx² + dy²)
            fx += G M[j] dx / r³
            U -= G M[i] M[j] / r / 2
    ax[i] = fx
print U to 17 digits
print ax[1] to 17 digits, ax[N] to 17 digits
