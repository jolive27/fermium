# 12 — The Coulomb barrier
#
# Two nuclei are both positively charged, so they repel. To fuse (or for a
# nucleus to capture an alpha particle) they have to get close enough to
# touch, at a distance of about R₁ + R₂ with R = r₀ A^(1/3). The electric
# potential energy at that distance is the height of the "Coulomb barrier":
#
#     V_C = Z₁ Z₂ e² / (4π ε₀ (R₁ + R₂))
#
# Nuclear physicists write e²/(4π ε₀) = α ħc ≈ 1.44 MeV fm, which makes the
# numbers easy to do in your head.  We compare the barrier with the typical
# thermal energy k_B T inside the Sun and find it is hundreds of times larger:
# classically the Sun could not shine. Quantum tunnelling saves the day
# (see example 23).

print "ħc =", ħ c in MeV fm to 6 digits
print "e²/(4π ε₀) =", e² / (4π ε_0) in MeV fm to 6 digits, "  α ħc =", α ħ c in MeV fm to 6 digits

r0 = 1.20 fm
R(A) = r0 A^(1/3)
V_C(Z1, A1, Z2, A2) = Z1 Z2 e² / (4π ε_0 (R(A1) + R(A2)))

print "p + p:        ", V_C(1, 1, 1, 1) in MeV
print "D + T:        ", V_C(1, 2, 1, 3) in MeV
print "α + C-12:     ", V_C(2, 4, 6, 12) in MeV
print "C-12 + C-12:  ", V_C(6, 12, 6, 12) in MeV
print "α + U-238:    ", V_C(2, 4, 92, 238) in MeV
print "O-16 + Pb-208:", V_C(8, 16, 82, 208) in MeV

# Thermal energy in the Sun's core (15.7 million kelvin)
T_core = 1.57e7 K
kT = k_B T_core
print "k_B T in the solar core:", kT in keV
print "barrier / thermal energy for p + p:", V_C(1, 1, 1, 1) / kT
# Fraction of protons with energy above the barrier (Boltzmann tail ~ exp(-E/kT))
print "Boltzmann factor exp(-V/kT):", exp(-V_C(1, 1, 1, 1) / kT)

# The temperature at which the average thermal energy (3/2 k_B T) would
# reach the p + p barrier
T_needed = 2 V_C(1, 1, 1, 1) / (3 k_B)
print "temperature needed classically:", T_needed

# The distance of closest approach for an alpha with 5 MeV hitting gold head-on
# (Rutherford's experiment): all kinetic energy becomes potential energy.
E_α = 5.00 MeV
d = 2 * 79 e² / (4π ε_0 E_α)
print "closest approach of a 5 MeV alpha to gold:", d in fm, " (gold's radius:", R(197) in fm, ")"
