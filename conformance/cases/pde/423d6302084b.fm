L = 1 m
D = 0.01 m^2/s
solve partial u/partial t = D * partial^2u/partial x^2
    with u(x, 0 s) = 2 K * sin(pi x / L), u(0 m, t) = 0 K, u(L, t) = 0 K
    for x from 0 m to L, t from 0 s to 10 s
print u(0.5 m, 10 s), "  exact:", 2 K exp(-D pi^2 10 [s] / L^2)
print partial u/partial x(0 m, 5 s), partial u/partial t(0.5 m, 5 s)
