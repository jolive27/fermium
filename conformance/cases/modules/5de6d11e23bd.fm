import em

print (em.coulomb_field(1 nC, 2 m)) / (1 V/m) to 12 digits
print (em.coulomb_force(e, -e, 1 nm)) / (1 N) to 12 digits
print (em.coulomb_potential(1 nC, 2 m)) / (1 V) to 12 digits
print (em.parallel_plate_capacitance(1 cm^2, 1 mm)) / (1 F) to 12 digits
print (em.capacitor_energy(2 μF, 10 V)) / (1 J) to 12 digits
print (em.rc_time_constant(1 kΩ, 3 μF)) / (1 s) to 12 digits
print (em.rc_charging_voltage(5 V, 1 ms, 2 ms)) / (1 V) to 12 digits
print (em.cyclotron_angular_frequency(e, 1.5 T, m_p)) / (1 rad/s) to 12 digits
print (em.cyclotron_frequency(-e, 1.5 T, m_e)) / (1 rev/s) to 12 digits
print (em.larmor_radius(m_e, 1e6 m/s, -e, 1 mT)) / (1 m) to 12 digits
print (em.skin_depth(1.68e-8 ohm m, 60 Hz, 1)) / (1 m) to 12 digits
print (em.wire_field(10 A, 1 cm)) / (1 T) to 12 digits
print (em.solenoid_field(1000 /m, 2 A)) / (1 T) to 12 digits
