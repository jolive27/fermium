# Astrophysics 21 — White dwarfs: polytropes and the Chandrasekhar mass
#
# (Carroll & Ostlie §16.4 and Problem 16.14; Kippenhahn, Weigert & Weiss
# §19 and §37; Chandrasekhar 1939, ch. XI.)  A white dwarf is held up by
# degenerate electrons (μₑ = 2 nucleons per electron, C/O).
#
#  (a) Lane–Emden: solve (1/ξ²)(ξ² θ')' = −θⁿ for n = 1.5 and n = 3, and find
#      the surface ξ₁ and ω_n = −ξ₁² θ'(ξ₁) (Chandrasekhar's table:
#      3.65375, 2.71406 and 6.89685, 2.01824).
#  (b) Non-relativistic electrons, P = K₁ ρ^(5/3), K₁ = (ħ²/5mₑ)(3π²)^(2/3)/(μₑ m_u)^(5/3),
#      form an n = 1.5 polytrope.  For M = 0.6 M☉ find the central density (by
#      solving M(ρ_c) = 0.6 M☉) and the radius; check R ∝ M^(−1/3).
#  (c) Ultra-relativistic electrons, P = K₂ ρ^(4/3), K₂ = (ħc/4)(3π²)^(1/3)/(μₑ m_u)^(4/3),
#      give the n = 3 polytrope and the Chandrasekhar mass
#      M_Ch = 4π ω₃ (K₂/(πG))^(3/2)  (≈ 1.44 M☉ in C&O; 1.46 M☉ with these constants).
#  (d) The full Fermi-gas equation of state.  With the relativity parameter
#      y = √(1 + x²), x = p_F/(mₑc), hydrostatic equilibrium becomes
#          dy/dr = −(μₑ m_u / mₑc²) G M / r²,   dM/dr = 4π r² ρ,
#          ρ = μₑ m_u (8π/3)(mₑc/h)³ (y² − 1)^(3/2),
#      and the surface is where y = 1.  Integrate outward for a range of
#      central x_c and tabulate M and R: the mass must approach M_Ch from
#      below and R must shrink towards 0 (the Chandrasekhar mass–radius relation).

μ_e = 2

# (a) Lane–Emden.  Past the surface θ < 0 and θ^1.5 has no value, so the
# density term is written max(θ, 0)ⁿ.  An ODE solution inside a function can't
# be handed to an algebraic solve (FRICTION.md), so the two polytropes are
# written out separately instead of as one function of n.
ξ0 = 1e-4
solve θa'' = -2 θa' / ξ - max(θa, 0)^1.5
  with θa(ξ0) = 1 - ξ0²/6 + 1.5 ξ0⁴/120, θa'(ξ0) = -ξ0/3 + 1.5 ξ0³/30
  for ξ from ξ0 to 8
solve θa(ξ1_15) = 0 for ξ1_15 from 2 to 8
ω_15 = -ξ1_15² θa'(ξ1_15)
solve θb'' = -2 θb' / ξ - θb³
  with θb(ξ0) = 1 - ξ0²/6 + 3 ξ0⁴/120, θb'(ξ0) = -ξ0/3 + 3 ξ0³/30
  for ξ from ξ0 to 8
solve θb(ξ1_3) = 0 for ξ1_3 from 2 to 8
ω_3 = -ξ1_3² θb'(ξ1_3)
print "(a) n = 1.5: xi_1 =", ξ1_15 to 9 digits, " omega =", ω_15 to 9 digits
print "    n = 3:   xi_1 =", ξ1_3 to 9 digits, " omega =", ω_3 to 9 digits

# (b) polytrope scalings: a² = (n+1) K ρ_c^(1/n − 1)/(4πG),  R = ξ₁ a,  M = 4π a³ ρ_c ω
K1 = (ħ² / (5 m_e)) (3π²)^(2/3) / (μ_e m_u)^(5/3)
a_15(ρc) = √(2.5 K1 ρc^(-1/3) / (4π G))
mass_15(ρc) = 4π a_15(ρc)³ ρc ω_15
solve mass_15(ρc) = 0.6 M_sun for ρc from 1e6 kg/m³ to 1e12 kg/m³
R06 = ξ1_15 a_15(ρc)
print "(b) M = 0.6 Msun: rho_c =", ρc in kg/m³ to 8 digits, " R =", R06 in km to 8 digits
solve mass_15(ρ1) = 1.0 M_sun for ρ1 from 1e6 kg/m³ to 1e12 kg/m³
R10 = ξ1_15 a_15(ρ1)
print "    R(1.0)/R(0.6) =", R10 / R06 to 8 digits, "  (0.6/1.0)^(1/3) =", 0.6^(1/3) to 8 digits

# (c)
K2 = (ħ c / 4) (3π²)^(1/3) / (μ_e m_u)^(4/3)
M_Ch = 4π ω_3 (K2 / (π G))^(3/2)
print "(c) M_Ch =", M_Ch in Msun to 8 digits

# (d) the full equation of state
n_scale = (8π / 3) (m_e c / h)³
# Outside the star y keeps falling (dy/dr = −…GM/r²) and for a massive dwarf
# passes y = −1, where (y² − 1)^(3/2) would switch the density back on.  There
# is no "stop when y = 1" for solve, so the density is cut off by hand:
ρ_of(y) = if y > 1 then μ_e m_u n_scale (y² - 1)^(3/2) else 0 kg/m³
r_in = 1 m
M_last = 0 kg
for x_c in [0.3, 1, 3, 10, 30, 100]
    y_c = √(1 + x_c²)
    solve y' = -(μ_e m_u / (m_e c²)) G M / r²,
          M' = 4π r² ρ_of(y)
      with y(r_in) = y_c, M(r_in) = (4/3) π r_in³ ρ_of(y_c)
      for r from r_in to 3e7 m
    solve y(R) = 1 for R from r_in to 3e7 m
    print "x_c =", x_c, " rho_c =", ρ_of(y_c) in kg/m³ to 6 digits, " M =", M(R) in Msun to 8 digits, " R =", R in km to 8 digits
    M_last = M(R)
print "(d) M(x_c = 100) / M_Ch =", M_last / M_Ch to 6 digits
