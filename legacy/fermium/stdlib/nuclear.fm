# nuclear: binding energies, Q-values, radioactive decay and tunneling
# A (mass number) and Z (proton number) are plain numbers.  Energies come out in MeV.

# semi-empirical mass formula coefficients (least-squares fit quoted by Rohlf, "Modern Physics", 1994)
a_V = 15.75 MeV
a_S = 17.8 MeV
a_C = 0.711 MeV
a_A = 23.7 MeV
a_P = 11.18 MeV

# pairing term of the SEMF: +a_P/√A for even-even nuclei, −a_P/√A for odd-odd, 0 for odd A
semf_pairing(A [1], Z [1]) = if mod(A, 2) == 1 then 0 MeV
                             else if mod(Z, 2) == 0 then a_P / √A
                             else -a_P / √A

# binding energy from the semi-empirical (Bethe–Weizsäcker) mass formula
semf_binding(A [1], Z [1]) = a_V A - a_S A^(2/3) - a_C Z (Z - 1) / A^(1/3) - a_A (A - 2*Z)² / A + semf_pairing(A, Z)

# binding energy per nucleon B/A from the SEMF
semf_binding_per_nucleon(A [1], Z [1]) = semf_binding(A, Z) / A

# Q-value of a reaction or decay from the total mass before and after: (m_initial − m_final) c²
Q_value(m_initial [kg], m_final [kg]) = (m_initial - m_final) c² in MeV

# nuclear radius R = r0 A^(1/3) with r0 = 1.2 fm
nuclear_radius(A [1]) = 1.2 fm * A^(1/3)

# decay constant λ = ln 2 / t½
decay_constant(t_half [s]) = ln(2) / t_half

# mean lifetime τ = t½ / ln 2
mean_lifetime(t_half [s]) = t_half / ln(2)

# activity of N nuclei with half-life t½: A = λ N = N ln 2 / t½
activity(N [1], t_half [s]) = N ln(2) / t_half in Bq

# how much of N0 (a number, an activity or a mass) is left after time t: N0 2^(−t/t½)
remaining(N0, t_half [s], t [s]) = N0 exp(-ln(2) t / t_half)

# Bateman two-member chain P → D (D starts at zero): the number of daughter nuclei at time t
bateman_daughter(N0, t_half_parent [s], t_half_daughter [s], t [s]) =
    λp = ln(2) / t_half_parent
    λd = ln(2) / t_half_daughter
    δt = (λd - λp) t
    # (e^(−λp t) − e^(−λd t)) / (λd − λp) = t e^(−λp t) (1 − e^(−δt)) / δt: written with expm1 when δt is
    # small, so nearly equal half-lives don't cancel, and equal ones give the limit N0 λ t e^(−λt)
    N0 λp * (if abs(δt) > 1 then (exp(-λp t) - exp(-λd t)) / (λd - λp)
             else t exp(-λp t) * (if δt == 0 then 1 else -expm1(-δt) / δt))

# Sommerfeld parameter η = Z1 Z2 α c / v of two nuclei with relative speed v
sommerfeld_parameter(Z1 [1], Z2 [1], v [m/s]) = Z1 Z2 α c / v

# Gamow energy E_G = 2 μ c² (π α Z1 Z2)² for reduced mass μ
gamow_energy(Z1 [1], Z2 [1], μ [kg]) = 2 μ c² (π α Z1 Z2)² in MeV

# Gamow (tunneling) factor exp(−2π η) = exp(−√(E_G/E)) at centre-of-mass energy E, reduced mass μ
gamow_factor(Z1 [1], Z2 [1], E [J], μ [kg]) = exp(-√(gamow_energy(Z1, Z2, μ) / E))
